{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Zabbix Webhook",
      "program": "${workspaceFolder}/webhook.js",
      "cwd": "${workspaceFolder}",
      "runtimeArgs": [
        "--require",
        "${workspaceFolder}/debug-context.js"
      ],
      "console": "integratedTerminal",
      "env": {
        "DEBUG_WEBHOOK": "1"
      },
      "skipFiles": [
        "<node_internals>/**"
      ]
    }
  ]
}
